hanxidata/

# Windows syso 构建中间产物（扫描 main 包目录时自动化生成）
*.syso
*.exe
!build/tools/*.exe

.idea/
.vscode/

# 多 agent 协调 worktree（含 node_modules junction，勿入库）
.claude/worktrees/
docs/FEATURES_OVERVIEW.pdf

# Claude 本机个人配置(工具链 PATH 注入,不入库)
