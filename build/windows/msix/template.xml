<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="hanxi.exe"
        Arguments=""
        InstallLocation="C:\Program Files\Hanxi">
    </Installer>
    <PackageInformation
        PackageName="Hanxi"
        PackageDisplayName="Hanxi"
        PublisherName="CN=Hanxi"
        PublisherDisplayName="Hanxi"
        Version="0.3.0.0"
        PackageDescription="集中安装、管理与运行常用开源软件">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="io.hanxi.desktop"
                Description="开源工具工作台"
                DisplayName="Hanxi"
                ExecutableName="hanxi.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Hanxi</DisplayName>
            <PublisherDisplayName>Hanxi</PublisherDisplayName>
            <Description>集中安装、管理与运行常用开源软件</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="hanxi.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
